{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile and application settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "profile": {
          "type": "object",
          "properties": {
            "skills": {
              "type": "object",
              "properties": {
                "coverage": { "type": "number" },
                "sales": { "type": "number" },
                "sku": { "type": "number" }
              }
            },
            "preferredHours": {
              "type": "object",
              "properties": {
                "morning": { "type": "number" },
                "afternoon": { "type": "number" }
              }
            }
          }
        },
        "settings": {
          "type": "object",
          "properties": {
            "themeColor": { "type": "string" },
            "appTitle": { "type": "string" },
            "themeMode": { "type": "string", "enum": ["dark", "light"] },
            "kpiWeights": { "type": "object" }
          }
        }
      },
      "required": ["uid", "email"]
    },
    "Month": {
      "title": "Monthly Data",
      "description": "KPI targets and actuals for a specific month",
      "type": "object",
      "properties": {
        "monthIndex": { "type": "integer" },
        "salesTarget": { "type": "number" },
        "salesActual": { "type": "number" },
        "coverageTarget": { "type": "number" },
        "coverageActual": { "type": "number" },
        "sales15DaysActual": { "type": "number" },
        "skuActual": { "type": "number" },
        "customName": { "type": "string" },
        "customPoints": { "type": "number" }
      },
      "required": ["monthIndex"]
    },
    "Note": {
      "title": "Note",
      "description": "Personal note or task",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "createdAt": { "type": "number" },
        "isCompleted": { "type": "boolean" },
        "tag": { "type": "string" }
      },
      "required": ["text", "createdAt", "isCompleted"]
    },
    "Memory": {
      "title": "Memory",
      "description": "Knowledge base entry",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "keyPoints": { "items": { "type": "string" }, "type": "array" },
        "tags": { "items": { "type": "string" }, "type": "array" },
        "createdAt": { "type": "number" }
      },
      "required": ["title", "summary", "createdAt"]
    },
    "DailyTask": {
      "title": "Daily Task",
      "description": "Tactical action plan task",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "target": { "type": "number" },
        "done": { "type": "number" },
        "isCompleted": { "type": "boolean" },
        "isStarted": { "type": "boolean" },
        "priority": { "type": "string", "enum": ["high", "medium", "low"] },
        "expectedImpact": { "type": "string" },
        "confidence": { "type": "number" },
        "createdAt": { "type": "number" },
        "type": { "type": "string" }
      },
      "required": ["text", "priority", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "The root user document containing profile and settings"
    },
    "users/{userId}/months/{monthIndex}": {
      "schema": "Month",
      "description": "Monthly KPI records"
    },
    "users/{userId}/notes/{noteId}": {
      "schema": "Note",
      "description": "User notes to track personal tasks"
    },
    "users/{userId}/memories/{memoryId}": {
      "schema": "Memory",
      "description": "Knowledge base entries"
    },
    "users/{userId}/dailyTasks/{taskId}": {
      "schema": "DailyTask",
      "description": "Daily tactical actions"
    }
  }
}
