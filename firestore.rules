rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Global User matching
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) 
                     && incoming().uid == existing().uid;

      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'email'])
           && data.uid == request.auth.uid
           && data.email is string && data.email.size() <= 256
           && (!('profile' in data) || data.profile is map)
           && (!('settings' in data) || data.settings is map);
      }

      // Months subcollection
      match /months/{monthId} {
        allow list, get: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidMonth(incoming());
        allow delete: if isOwner(userId);

        function isValidMonth(data) {
          return data.monthIndex is int && data.monthIndex >= 0 && data.monthIndex <= 11
             && (!('salesTarget' in data) || data.salesTarget is number)
             && (!('salesActual' in data) || data.salesActual is number)
             && (!('coverageTarget' in data) || data.coverageTarget is number)
             && (!('coverageActual' in data) || data.coverageActual is number);
        }
      }

      // Notes subcollection
      match /notes/{noteId} {
        allow list, get: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidNote(incoming());
        allow delete: if isOwner(userId);

        function isValidNote(data) {
          return data.text is string && data.text.size() <= 2000
             && data.createdAt is int
             && data.isCompleted is bool;
        }
      }

      // Memories subcollection
      match /memories/{memoryId} {
        allow list, get: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidMemory(incoming());
        allow delete: if isOwner(userId);

        function isValidMemory(data) {
          return data.title is string && data.title.size() <= 256
             && data.summary is string && data.summary.size() <= 5000
             && data.createdAt is int
             && (!('tags' in data) || (data.tags is list && data.tags.size() <= 20));
        }
      }

      // Daily Tasks subcollection
      match /dailyTasks/{taskId} {
        allow list, get: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidDailyTask(incoming());
        allow delete: if isOwner(userId);

        function isValidDailyTask(data) {
          return data.text is string && data.text.size() <= 1000
             && data.priority in ['high', 'medium', 'low']
             && data.createdAt is int
             && (!('done' in data) || data.done is number)
             && (!('target' in data) || data.target is number)
             && (!('isCompleted' in data) || data.isCompleted is bool)
             && (!('isStarted' in data) || data.isStarted is bool);
        }
      }
    }
  }
}
